{
  "name": "浏览器搜索",
  "version": 1,
  "author": "LTT_GKD builtin",
  "rules": [
    {
      "id": "com.quark.browser_splash",
      "name": "夸克开屏",
      "packageName": "com.quark.browser",
      "activity": null,
      "enabled": true,
      "priority": 100,
      "throttleMs": 5000,
      "match": {
        "type": "TEXT",
        "text": [
          "跳过",
          "跳过广告",
          "Skip"
        ],
        "regex": false,
        "caseInsensitive": true
      },
      "action": {
        "type": "CLICK_NODE",
        "delayMs": 0
      }
    },
