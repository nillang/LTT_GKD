{
  "name": "browser",
  "version": 1,
  "author": "ltt_gkd",
  "rules": [
    {
      "id": "com.UCMobile_splash",
      "name": "UC浏览器开屏",
      "packageName": "com.UCMobile",
      "activity": null,
      "enabled": true,
      "priority": 100,
      "throttleMs": 5000,
      "match": {
        "type": "TEXT",
        "text": [
          "跳过",
          "跳过广告",
          "Skip"
        ],
        "regex": false,
        "caseInsensitive": true
      },
      "action": {
        "type": "CLICK_NODE",
        "delayMs": 0
      }
    },
    {
      "id": "com.tencent.mtt_splash",
