{
  "name": "电商购物类",
  "version": 1,
  "author": "LTT_GKD builtin",
  "rules": [
    {
      "id": "com.taobao.taobao_splash",
      "name": "淘宝开屏",
      "packageName": "com.taobao.taobao",
      "priority": 100,
      "throttleMs": 5000,
      "match": {
        "type": "TEXT",
        "text": ["跳过", "跳过广告", "Skip", "关闭"],
        "caseInsensitive": true
      },
      "action": { "type": "CLICK_NODE", "delayMs": 0 }
    },
    {
      "id": "com.taobao.taobao_popup",
      "name": "淘宝弹窗广告",
      "packageName": "com.taobao.taobao",
      "priority": 80,
      "throttleMs": 3000,
      "match": {
        "type": "TEXT",
        "text": ["关闭", "不感兴趣", "我知道了"],
        "caseInsensitive": true
      },
      "action": { "type": "CLICK_NODE", "delayMs": 0 }
    },
    {
      "id": "com.jingdong.app.mall_splash",
