{
  "name": "社区类规则集",
  "version": 1,
  "author": "ltt_gkd",
  "rules": [
    {
      "id": "com.baidu.tieba_splash",
      "name": "百度贴吧开屏",
      "packageName": "com.baidu.tieba",
      "enabled": true,
      "priority": 100,
      "throttleMs": 5000,
      "match": {
        "type": "TEXT",
        "text": ["跳过", "跳过广告", "Skip"],
        "ids": [],
        "regex": false,
        "caseInsensitive": true
      },
      "action": { "type": "CLICK_NODE", "delayMs": 0 }
    },
