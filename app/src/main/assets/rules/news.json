{
  "name": "news",
  "version": 1,
  "author": "ltt_gkd",
  "rules": [
    {
      "id": "com.ss.android.article.news_splash",
      "name": "今日头条开屏",
      "packageName": "com.ss.android.article.news",
      "activity": null,
      "enabled": true,
      "priority": 100,
      "throttleMs": 5000,
      "match": {
        "type": "TEXT",
        "text": [
          "跳过",
          "跳过广告",
          "Skip"
        ],
        "regex": false,
        "caseInsensitive": true
      },
      "action": {
        "type": "CLICK_NODE",
        "delayMs": 0
      }
    },
