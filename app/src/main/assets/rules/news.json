{
  "name": "新闻资讯",
  "version": 1,
  "author": "LTT_GKD builtin",
  "rules": [
    {
      "id": "com.ss.android.article.news_splash",
      "name": "今日头条开屏",
      "packageName": "com.ss.android.article.news",
      "activity": null,
      "enabled": true,
      "priority": 100,
      "throttleMs": 5000,
      "match": {
        "type": "TEXT",
        "text": [
          "跳过",
          "跳过广告",
          "Skip"
        ],
        "regex": false,
        "caseInsensitive": true
      },
      "action": {
        "type": "CLICK_NODE",
        "delayMs": 0
      }
    },
    {
      "id": "com.ss.android.article.news_popup",
      "name": "今日头条弹窗",
      "packageName": "com.ss.android.article.news",
      "activity": null,
      "enabled": true,
      "priority": 80,
      "throttleMs": 3000,
      "match": {
        "type": "TEXT",
        "text": [
          "关闭",
          "关闭广告",
          "以后再说",
          "跳过",
          "×"
        ],
        "regex": false,
        "caseInsensitive": true
      },
      "action": {
        "type": "CLICK_NODE",
