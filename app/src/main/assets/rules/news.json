{
  "name": "新闻资讯类规则集",
  "version": 1,
  "author": "ltt_gkd",
  "rules": [
    {
      "id": "com.ifeng.news_splash",
      "name": "凤凰新闻开屏",
      "packageName": "com.ifeng.news",
      "enabled": true,
      "priority": 100,
      "throttleMs": 5000,
      "match": {
        "type": "TEXT",
        "text": ["跳过", "跳过广告", "Skip"],
        "ids": [],
        "regex": false,
        "caseInsensitive": true
      },
      "action": { "type": "CLICK_NODE", "delayMs": 0 }
    },
    {
