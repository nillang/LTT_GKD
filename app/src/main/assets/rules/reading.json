{
  "name": "阅读类规则集",
  "version": 1,
  "author": "ltt_gkd",
  "rules": [
    {
      "id": "com.qidian.YDReader_splash",
      "name": "起点读书开屏",
      "packageName": "com.qidian.YDReader",
      "enabled": true,
      "priority": 100,
      "throttleMs": 5000,
      "match": {
        "type": "TEXT",
        "text": ["跳过", "跳过广告", "Skip"],
        "ids": [],
        "regex": false,
        "caseInsensitive": true
      },
      "action": { "type": "CLICK_NODE", "delayMs": 0 }
    },
    {
      "id": "com.dragon.read_splash",
      "name": "番茄免费小说开屏",
