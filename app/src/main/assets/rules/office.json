{
  "name": "office",
  "version": 1,
  "author": "ltt_gkd",
  "rules": [
    {
      "id": "cn.wps.moffice_eng_splash",
      "name": "WPS Office开屏",
      "packageName": "cn.wps.moffice_eng",
      "activity": null,
      "enabled": true,
      "priority": 100,
      "throttleMs": 5000,
      "match": {
        "type": "TEXT",
        "text": [
          "跳过",
          "跳过广告",
          "Skip"
        ],
        "regex": false,
        "caseInsensitive": true
      },
      "action": {
        "type": "CLICK_NODE",
        "delayMs": 0
      }
    },
