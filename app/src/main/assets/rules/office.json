{
  "name": "办公网盘",
  "version": 1,
  "author": "LTT_GKD builtin",
  "rules": [
    {
      "id": "com.kingsoft.office_splash",
      "name": "WPS Office开屏",
      "packageName": "com.kingsoft.office",
      "activity": null,
      "enabled": true,
      "priority": 100,
      "throttleMs": 5000,
      "match": {
        "type": "TEXT",
        "text": [
          "跳过",
          "跳过广告",
          "Skip"
        ],
        "regex": false,
        "caseInsensitive": true
      },
      "action": {
        "type": "CLICK_NODE",
        "delayMs": 0
      }
    },
    {
      "id": "com.kingsoft.office_popup",
      "name": "WPS Office弹窗",
      "packageName": "com.kingsoft.office",
      "activity": null,
      "enabled": true,
      "priority": 80,
      "throttleMs": 3000,
      "match": {
        "type": "TEXT",
        "text": [
          "关闭",
          "关闭广告",
          "取消",
          "以后再说",
          "跳过",
          "×"
        ],
        "regex": false,
        "caseInsensitive": true
      },
      "action": {
        "type": "CLICK_NODE",
        "delayMs": 0
      }
