{
  "name": "工具系统类",
  "version": 1,
  "author": "LTT_GKD builtin",
  "rules": [
    {
      "id": "com.android.packageinstaller_popup",
      "name": "系统安装器广告",
      "packageName": "com.android.packageinstaller",
      "priority": 90,
      "throttleMs": 3000,
      "match": {
        "type": "TEXT",
        "text": ["关闭", "取消", "不安装", "跳过"],
        "caseInsensitive": true
      },
      "action": { "type": "CLICK_NODE", "delayMs": 0 }
    },
    {
      "id": "com.miui.systemui_home_ad",
      "name": "MIUI 负一屏广告",
      "packageName": "com.miui.systemui.home",
      "priority": 70,
      "throttleMs": 3000,
      "match": {
        "type": "TEXT",
        "text": ["关闭", "不感兴趣", "知道了"],
        "caseInsensitive": true
      },
      "action": { "type": "CLICK_NODE", "delayMs": 0 }
    },
    {
      "id": "com.android.systemui_popup",
      "name": "系统UI弹窗",
      "packageName": "com.android.systemui",
      "priority": 60,
      "throttleMs": 3000,
      "match": {
        "type": "TEXT",
        "text": ["关闭", "知道了"],
        "caseInsensitive": true
      },
      "action": { "type": "CLICK_NODE", "delayMs": 0 }
    },
    {
      "id": "com.tencent.android.app.safeguard_splash",
      "name": "应用宝开屏",
      "packageName": "com.tencent.android.app.safeguard",
      "priority": 100,
      "throttleMs": 5000,
      "match": {
        "type": "TEXT",
        "text": ["跳过", "跳过广告", "Skip"],
        "caseInsensitive": true
      },
      "action": { "type": "CLICK_NODE", "delayMs": 0 }
    }
  ]
}
