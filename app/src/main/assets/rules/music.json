{
  "name": "音乐",
  "version": 1,
  "author": "LTT_GKD builtin",
  "rules": [
    {
      "id": "com.netease.cloudmusic_splash",
      "name": "网易云音乐开屏",
      "packageName": "com.netease.cloudmusic",
      "activity": null,
      "enabled": true,
      "priority": 100,
      "throttleMs": 5000,
      "match": {
        "type": "TEXT",
        "text": [
          "跳过",
          "跳过广告",
          "Skip"
        ],
        "regex": false,
        "caseInsensitive": true
      },
      "action": {
        "type": "CLICK_NODE",
        "delayMs": 0
      }
    },
    {
      "id": "com.netease.cloudmusic_popup",
      "name": "网易云音乐弹窗",
      "packageName": "com.netease.cloudmusic",
      "activity": null,
      "enabled": true,
      "priority": 80,
      "throttleMs": 3000,
      "match": {
        "type": "TEXT",
        "text": [
          "关闭",
          "关闭广告",
          "以后再说",
          "跳过",
          "×"
        ],
        "regex": false,
